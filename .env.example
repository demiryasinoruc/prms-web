# PRMS Web — Environment template
# Bu dosyayı kopyalayın:
#   - Geliştirme için: cp .env.example .env
#   - Production build için: cp .env.example .env.production
# .env ve .env.* dosyaları .gitignore'lıdır, repo'ya commit edilmez.

# Backend API base URL
# Geliştirme: https://localhost:7118
# Production: https://api.your-domain.com
VITE_API_URL=https://localhost:7118
